# Site URL (used by docker-compose for FRONTEND_URL, CORS, and CLI discovery)
# Set this to your server's LAN/public IP for remote access
# SITE_URL=http://192.168.50.25

# Database (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./wiclawhub.db

# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/wiclawhub

# Auth
SECRET_KEY=change-me-in-production

# JWT (falls back to SECRET_KEY if empty)
# JWT_SECRET_KEY=
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth - GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# OAuth - Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Rate limiting (requests per minute)
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Debug
DEBUG=false
