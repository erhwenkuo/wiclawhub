# WiClawHub Docker Configuration
# Copy this file to .env.docker and modify as needed.
# Usage: docker compose --env-file .env.docker up -d

# Site URL — your server's LAN IP or domain (used for CLI discovery, CORS, OAuth)
# Change this to your server's actual IP for remote/LAN access
SITE_URL=http://localhost

# Secret key for JWT signing — MUST change in production
SECRET_KEY=change-me-in-production

# PostgreSQL password (only used by docker-compose.postgres.yml)
POSTGRES_PASSWORD=wiclawhub

# Optional: OAuth providers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
